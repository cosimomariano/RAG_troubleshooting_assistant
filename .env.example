APP_ENV=development

# Server hostato sul pc
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Endpoint ollama hostato 
OLLAMA_BASE_URL=http://<OLLAMA_HOST>:11434
OLLAMA_MODEL=<OLLAMA_MODEL_NAME>
# Timeout in caso di ritardi nella risposta
OLLAMA_TIMEOUT_SECONDS=120

# Livello di loggatura
LOG_LEVEL=INFO

# Percorso contenente i documenti (base di conoscenza)
KNOWLEDGE_BASE_PATH=data/knowledge_base

# Modello per la parte di embedding
EMBEDDING_MODEL=<EMBEDDING_MODEL_NAME>

# Percorso per la persistenza dell'indice vettoriale e della mappatura dei chunk
VECTOR_STORE_PATH=data/vector_store

# Strategia di recupero: llm_only, dense, sparse oppure hybrid
RETRIEVAL_MODE=dense

# Elementi K massimi del retriever per la ricerca
RETRIEVAL_TOP_K=5

# Modello Cross-Encoder usato per riordinare i candidati del retrieval ibrido
RERANKER_MODEL=<RERANKER_MODEL_NAME>
RERANKER_BATCH_SIZE=32

# Numero di candidati RRF inviati al Cross-Encoder
RERANKER_CANDIDATE_TOP_N=20